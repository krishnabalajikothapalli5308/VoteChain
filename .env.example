# ── Sepolia RPC (get free from Alchemy or Infura) ──────────
# Alchemy: https://dashboard.alchemy.com → Create App → Ethereum Sepolia → Copy HTTPS URL
# Infura:  https://app.infura.io → Create Project → Sepolia endpoint
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# ── Your wallet private key (the account that will deploy) ──
# Export from MetaMask: Settings → Security → Export Private Key
# ⚠️  Never commit this file to Git. It is already in .gitignore
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Etherscan API key (optional, for contract verification) ─
# https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
